{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contract.ErrorBody": {
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_id",
            "body_decode_failed",
            "body_incomplete",
            "body_unavailable",
            "budget_exhausted",
            "config_invalid",
            "conflict",
            "database_locked",
            "database_unavailable",
            "export_failed",
            "extension_load_failed",
            "failed",
            "finding_not_found",
            "forbidden",
            "gate_tripped",
            "ingest_incomplete",
            "input_unparsed",
            "internal_error",
            "interrupted",
            "invalid_project_uuid",
            "invalid_request",
            "lint_failed",
            "login_failed",
            "method_not_allowed",
            "no_targets_in_scope",
            "no_targets_reachable",
            "not_authenticated",
            "not_found",
            "not_ready",
            "output_too_large",
            "partial",
            "payload_too_large",
            "pdf_failed",
            "preflight_failed",
            "project_not_found",
            "provider_missing",
            "proxy_auth_required",
            "queue_full",
            "rate_limited",
            "record_not_found",
            "scan_abandoned",
            "scan_not_found",
            "schema_outdated",
            "schema_too_new",
            "service_unavailable",
            "source_incompatible",
            "source_missing",
            "source_unreadable",
            "storage_disabled",
            "timed_out",
            "unauthorized",
            "unsupported_api_version",
            "unsupported_input_mode",
            "usage_error",
            "wait_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "did_you_mean": {
          "type": "string"
        },
        "usage_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    },
    "contract.ReceiptArtifact": {
      "properties": {
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "path",
        "bytes"
      ]
    },
    "database.DatabaseInfo": {
      "properties": {
        "path": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "driver",
        "size"
      ]
    },
    "database.DatabaseStats": {
      "properties": {
        "database": {
          "$ref": "#/$defs/database.DatabaseInfo"
        },
        "records": {
          "$ref": "#/$defs/database.RecordCounts"
        },
        "findings": {
          "$ref": "#/$defs/database.FindingsStats"
        },
        "http_methods": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_codes": {
          "$ref": "#/$defs/database.StatusCodeBreakdown"
        },
        "performance": {
          "$ref": "#/$defs/database.PerformanceMetrics"
        },
        "date_range": {
          "$ref": "#/$defs/database.DateRangeStats"
        },
        "scan_sessions": {
          "items": {
            "$ref": "#/$defs/database.ScanSessionStats"
          },
          "type": "array"
        },
        "top_hosts": {
          "items": {
            "$ref": "#/$defs/database.HostStats"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "database",
        "records",
        "findings",
        "http_methods",
        "status_codes",
        "performance",
        "date_range"
      ]
    },
    "database.DateRangeStats": {
      "properties": {
        "first_request": {
          "type": "string",
          "format": "date-time"
        },
        "last_request": {
          "type": "string",
          "format": "date-time"
        },
        "duration": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "first_request",
        "last_request",
        "duration"
      ]
    },
    "database.FindingsStats": {
      "properties": {
        "by_severity": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "by_severity",
        "total"
      ]
    },
    "database.HostStats": {
      "properties": {
        "scheme": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "request_count": {
          "type": "integer"
        },
        "finding_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scheme",
        "hostname",
        "port",
        "request_count",
        "finding_count"
      ]
    },
    "database.PerformanceMetrics": {
      "properties": {
        "avg_response_time": {
          "type": "integer"
        },
        "min_response_time": {
          "type": "integer"
        },
        "max_response_time": {
          "type": "integer"
        },
        "p50_response_time": {
          "type": "integer"
        },
        "p95_response_time": {
          "type": "integer"
        },
        "p99_response_time": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "avg_response_time",
        "min_response_time",
        "max_response_time",
        "p50_response_time",
        "p95_response_time",
        "p99_response_time"
      ]
    },
    "database.RecordCounts": {
      "properties": {
        "http_records": {
          "type": "integer"
        },
        "with_response": {
          "type": "integer"
        },
        "response_percent": {
          "type": "number"
        },
        "findings": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "http_records",
        "with_response",
        "response_percent",
        "findings"
      ]
    },
    "database.ScanSessionStats": {
      "properties": {
        "scan_uuid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "processed_count": {
          "type": "integer"
        },
        "scan_mode": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scan_uuid",
        "status",
        "processed_count"
      ]
    },
    "database.StatusCodeBreakdown": {
      "properties": {
        "success": {
          "type": "integer"
        },
        "redirect": {
          "type": "integer"
        },
        "client_err": {
          "type": "integer"
        },
        "server_err": {
          "type": "integer"
        },
        "by_code": {
          "anyOf": [
            {
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "success",
        "redirect",
        "client_err",
        "server_err",
        "by_code"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "db stats"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/database.DatabaseStats"
      },
      "type": "array",
      "maxItems": 1,
      "minItems": 1,
      "description": "Exactly one object: the command's single result."
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium db stats -j",
  "description": "Row counts and breakdowns for the store (one object). With --watch, stdout is a stream of these documents, one per line (NDJSON), ending with an error document if the stream stops on a failure."
}
