  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "kit js-beautify"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.kitBeautifyResult"
      },
      "type": "array",
      "maxItems": 1,
      "minItems": 1,
      "description": "Exactly one object: the command's single result."
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "redacted": {
      "type": "boolean"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium kit js-beautify -j",
  "description": "One beautified file: content (omitted with -o), the engine's status, and with --extract/--kinds the facts by kind (endpoints, routes with guards and literal meta, assets, graphql, realtime, dom_flows, paths) plus counts; --secrets adds redacted secret matches."
}
