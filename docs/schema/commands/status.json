{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.statusCountsView": {
      "properties": {
        "records": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        },
        "scans": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "records",
        "findings",
        "scans"
      ]
    },
    "cli.statusProxyView": {
      "properties": {
        "url": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url",
        "source"
      ]
    },
    "cli.statusRuleCount": {
      "properties": {
        "include": {
          "type": "integer"
        },
        "exclude": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "include",
        "exclude"
      ]
    },
    "cli.statusRunScan": {
      "properties": {
        "scan_uuid": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "effective_status": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "last_write_at": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scan_uuid",
        "effective_status"
      ]
    },
    "cli.statusScopeView": {
      "properties": {
        "origin_mode": {
          "type": "string"
        },
        "components": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/cli.statusRuleCount"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "origin_mode",
        "components"
      ]
    },
    "cli.statusView": {
      "properties": {
        "db_path": {
          "type": "string"
        },
        "db_error": {
          "type": "string"
        },
        "project_uuid": {
          "type": "string"
        },
        "project_name": {
          "type": "string"
        },
        "project_source": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/cli.statusScopeView"
        },
        "running": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/cli.statusRunScan"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "running_total": {
          "type": "integer"
        },
        "counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/cli.statusCountsView"
            },
            {
              "type": "null"
            }
          ]
        },
        "proxy": {
          "$ref": "#/$defs/cli.statusProxyView"
        },
        "skill_stale": {
          "type": "boolean"
        },
        "config_path": {
          "type": "string"
        },
        "sessions_dir": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "db_path",
        "project_uuid",
        "project_source",
        "scope",
        "running",
        "running_total",
        "counts",
        "proxy",
        "skill_stale",
        "config_path",
        "sessions_dir"
      ]
    },
    "contract.ErrorBody": {
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_id",
            "body_decode_failed",
            "body_incomplete",
            "body_unavailable",
            "browser_encryption_unsupported",
            "budget_exhausted",
            "config_invalid",
            "conflict",
            "database_locked",
            "database_unavailable",
            "export_failed",
            "extension_load_failed",
            "failed",
            "finding_not_found",
            "forbidden",
            "gate_tripped",
            "ingest_incomplete",
            "input_unparsed",
            "internal_error",
            "interrupted",
            "invalid_project_uuid",
            "invalid_request",
            "keyring_denied",
            "lint_failed",
            "login_failed",
            "method_not_allowed",
            "no_targets_in_scope",
            "no_targets_reachable",
            "not_authenticated",
            "not_found",
            "not_ready",
            "out_of_scope",
            "output_too_large",
            "partial",
            "payload_too_large",
            "pdf_failed",
            "preflight_failed",
            "project_not_found",
            "provider_missing",
            "provider_unreachable",
            "proxy_auth_required",
            "queue_full",
            "rate_limited",
            "record_not_found",
            "resume_mismatch",
            "scan_abandoned",
            "scan_not_found",
            "scan_running",
            "schema_outdated",
            "schema_too_new",
            "service_unavailable",
            "source_incompatible",
            "source_missing",
            "source_unreadable",
            "storage_disabled",
            "timed_out",
            "unauthorized",
            "unsupported_api_version",
            "unsupported_input_mode",
            "usage_error",
            "wait_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "did_you_mean": {
          "type": "string"
        },
        "usage_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        },
        "full_result": {
          "type": "string"
        },
        "dropped_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted"
      ]
    },
    "contract.ReceiptArtifact": {
      "properties": {
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "path",
        "bytes"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "status"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.statusView"
      },
      "type": "array",
      "maxItems": 1,
      "minItems": 1,
      "description": "Exactly one object: the command's single result."
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "redacted": {
      "type": "boolean"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium status -j",
  "description": "Orientation: database path, project and its source, scope rule counts per component, up to 5 running scans with liveness, record/finding/scan counts, the effective proxy and its source, skill staleness. No network calls."
}
