{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.kitUnlockWalkReport": {
      "properties": {
        "origin": {
          "type": "string"
        },
        "landing": {
          "$ref": "#/$defs/spitolas.UnlockRouteResult"
        },
        "routes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/spitolas.UnlockRouteResult"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "routes_skipped": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stubs_never_hit": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/spitolas.UnlockStubRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "writes_allowed": {
          "type": "boolean"
        },
        "totals": {
          "$ref": "#/$defs/spitolas.UnlockWalkTotals"
        },
        "stored": {
          "type": "boolean"
        },
        "store_skip": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "origin",
        "landing",
        "routes",
        "stubs_never_hit",
        "writes_allowed",
        "totals",
        "stored"
      ]
    },
    "contract.ErrorBody": {
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_id",
            "body_decode_failed",
            "body_incomplete",
            "body_unavailable",
            "browser_encryption_unsupported",
            "budget_exhausted",
            "config_invalid",
            "conflict",
            "database_locked",
            "database_unavailable",
            "export_failed",
            "extension_load_failed",
            "failed",
            "finding_not_found",
            "forbidden",
            "gate_tripped",
            "ingest_incomplete",
            "input_unparsed",
            "internal_error",
            "interrupted",
            "invalid_project_uuid",
            "invalid_request",
            "keyring_denied",
            "lint_failed",
            "login_failed",
            "method_not_allowed",
            "no_targets_in_scope",
            "no_targets_reachable",
            "not_authenticated",
            "not_found",
            "not_ready",
            "out_of_scope",
            "output_too_large",
            "partial",
            "payload_too_large",
            "pdf_failed",
            "preflight_failed",
            "project_not_found",
            "provider_missing",
            "provider_unreachable",
            "proxy_auth_required",
            "queue_full",
            "rate_limited",
            "record_not_found",
            "resume_mismatch",
            "scan_abandoned",
            "scan_not_found",
            "scan_running",
            "schema_outdated",
            "schema_too_new",
            "service_unavailable",
            "source_incompatible",
            "source_missing",
            "source_unreadable",
            "storage_disabled",
            "timed_out",
            "unauthorized",
            "unsupported_api_version",
            "unsupported_input_mode",
            "usage_error",
            "wait_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "did_you_mean": {
          "type": "string"
        },
        "usage_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        },
        "full_result": {
          "type": "string"
        },
        "dropped_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted"
      ]
    },
    "contract.ReceiptArtifact": {
      "properties": {
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "path",
        "bytes"
      ]
    },
    "spitolas.UnlockAbortedWrite": {
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "header_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "body": {
          "type": "string"
        },
        "body_bytes": {
          "type": "integer"
        },
        "body_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "url"
      ]
    },
    "spitolas.UnlockRequest": {
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "record_uuid": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "url"
      ]
    },
    "spitolas.UnlockRouteResult": {
      "properties": {
        "route": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "navigation": {
          "type": "string"
        },
        "final_url": {
          "type": "string"
        },
        "redirected": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "text_sample": {
          "type": "string"
        },
        "requests": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/spitolas.UnlockRequest"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "aborted_writes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/spitolas.UnlockAbortedWrite"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "stubs_hit": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/spitolas.UnlockStubHit"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "route",
        "url",
        "navigation",
        "final_url",
        "redirected",
        "requests",
        "aborted_writes",
        "stubs_hit"
      ]
    },
    "spitolas.UnlockStubHit": {
      "properties": {
        "stub": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "stub",
        "method",
        "path",
        "url"
      ]
    },
    "spitolas.UnlockStubRef": {
      "properties": {
        "stub": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "stub",
        "method",
        "path"
      ]
    },
    "spitolas.UnlockWalkTotals": {
      "properties": {
        "routes": {
          "type": "integer"
        },
        "rendered": {
          "type": "integer"
        },
        "redirected": {
          "type": "integer"
        },
        "real_requests": {
          "type": "integer"
        },
        "records_stored": {
          "type": "integer"
        },
        "store_errors": {
          "type": "integer"
        },
        "aborted_writes": {
          "type": "integer"
        },
        "aborted_out_of_scope": {
          "type": "integer"
        },
        "stubs_hit": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "routes",
        "rendered",
        "redirected",
        "real_requests",
        "records_stored",
        "aborted_writes",
        "aborted_out_of_scope",
        "stubs_hit"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "kit unlock-walk"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.kitUnlockWalkReport"
      },
      "type": "array",
      "maxItems": 1,
      "minItems": 1,
      "description": "Exactly one object: the command's single result."
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "redacted": {
      "type": "boolean"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium kit unlock-walk -j",
  "description": "One SPA walk on forged client state: landing and per-route navigation (final_url, redirected, title, text_sample), the real requests each sent with the record_uuid they are stored as, the writes failed in the browser (aborted_writes, by shape), the stubs hit, stubs_never_hit and totals. Stubbed responses are never stored or listed as requests."
}
