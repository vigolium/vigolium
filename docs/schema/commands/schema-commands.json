{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.commandTraitView": {
      "properties": {
        "command": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "db": {
          "type": "string"
        },
        "reads_store": {
          "type": "boolean"
        },
        "mutates": {
          "type": "boolean"
        },
        "writes_global": {
          "type": "boolean"
        },
        "sends_traffic": {
          "type": "boolean"
        },
        "read_only_flag": {
          "type": "boolean"
        },
        "value_flags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/cli.targetSpec"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "reach": {
          "type": "string"
        },
        "reach_flags": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/cli.reachFlag"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "reach_note": {
          "type": "string"
        },
        "pipeline": {
          "type": "string",
          "enum": [
            "full",
            "single-request"
          ]
        },
        "translates_to": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "command",
        "kind",
        "db",
        "reads_store",
        "mutates",
        "writes_global",
        "sends_traffic",
        "read_only_flag",
        "value_flags",
        "aliases",
        "targets",
        "reach",
        "reach_flags"
      ]
    },
    "cli.reachFlag": {
      "properties": {
        "flag": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "with": {
          "type": "string"
        },
        "with_short": {
          "type": "string"
        },
        "reach": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "flag",
        "reach"
      ]
    },
    "cli.targetSpec": {
      "properties": {
        "flag": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "positional": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "pins": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "contract.ErrorBody": {
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_id",
            "body_decode_failed",
            "body_incomplete",
            "body_unavailable",
            "browser_encryption_unsupported",
            "budget_exhausted",
            "config_invalid",
            "conflict",
            "database_locked",
            "database_unavailable",
            "export_failed",
            "extension_load_failed",
            "failed",
            "finding_not_found",
            "forbidden",
            "gate_tripped",
            "ingest_incomplete",
            "input_unparsed",
            "internal_error",
            "interrupted",
            "invalid_project_uuid",
            "invalid_request",
            "keyring_denied",
            "lint_failed",
            "login_failed",
            "method_not_allowed",
            "no_targets_in_scope",
            "no_targets_reachable",
            "not_authenticated",
            "not_found",
            "not_ready",
            "out_of_scope",
            "output_too_large",
            "pace_unsupported",
            "partial",
            "payload_too_large",
            "pdf_failed",
            "preflight_failed",
            "project_not_found",
            "provider_missing",
            "provider_unreachable",
            "proxy_auth_required",
            "queue_full",
            "rate_limited",
            "record_not_found",
            "refused_by_policy",
            "resume_mismatch",
            "scan_abandoned",
            "scan_not_found",
            "scan_running",
            "schema_outdated",
            "schema_too_new",
            "service_unavailable",
            "source_incompatible",
            "source_missing",
            "source_unreadable",
            "storage_disabled",
            "timed_out",
            "unauthorized",
            "unsupported_api_version",
            "unsupported_input_mode",
            "usage_error",
            "wait_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "did_you_mean": {
          "type": "string"
        },
        "usage_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        },
        "full_result": {
          "type": "string"
        },
        "dropped_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted"
      ]
    },
    "contract.ReceiptArtifact": {
      "properties": {
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "path",
        "bytes"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "schema commands"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.commandTraitView"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "redacted": {
      "type": "boolean"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    },
    "global_value_flags": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "global_reach_flags": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/cli.reachFlag"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "global_value_flags",
    "global_reach_flags",
    "kind"
  ],
  "title": "vigolium schema commands -j",
  "description": "One row per command: kind, db (none/read/write), reads_store, mutates, writes_global, sends_traffic, read_only_flag, value_flags, aliases (every other spelling, `run \u003cphase\u003e` included), targets (the flag or positional naming a target, and its kind: url, host, file, input, record_uuid, scan_uuid, finding_id), reach (none, line, store, unbounded), reach_flags (each set flag replaces the reach, in order), pipeline (full or single-request, on the commands that run the scan pipeline) and translates_to (the native lines a shim or phase front door runs as); global_value_flags are the root's, global_reach_flags apply to every command."
}
