{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.browserReplaySummary": {
      "properties": {
        "requested_url": {
          "type": "string"
        },
        "final_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "dialogs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "original_method": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "requested_url"
      ]
    },
    "cli.replayDryRunView": {
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "overlay_headers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_override": {
          "type": "boolean"
        },
        "would_save": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "url",
        "source",
        "request",
        "overlay_headers",
        "raw_override",
        "would_save"
      ]
    },
    "cli.replayOnceView": {
      "properties": {
        "record_uuid": {
          "type": "string"
        },
        "saved": {
          "type": "boolean"
        },
        "save_skipped": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "final_url": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "response_time_ms": {
          "type": "integer"
        },
        "content_type": {
          "type": "string"
        },
        "response_length": {
          "type": "integer"
        },
        "body": {
          "type": "string"
        },
        "body_truncated": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "record_uuid",
        "saved",
        "method",
        "url",
        "final_url",
        "status",
        "response_time_ms",
        "response_length",
        "body",
        "body_truncated"
      ]
    },
    "cli.replayOutput": {
      "properties": {
        "source": {
          "type": "string"
        },
        "record_uuid": {
          "type": "string"
        },
        "finding_id": {
          "type": "integer"
        },
        "input_type": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "cookies_preloaded": {
          "type": "integer"
        },
        "jar_path": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/replay.Result"
            },
            {
              "type": "null"
            }
          ]
        },
        "browser": {
          "$ref": "#/$defs/cli.browserReplaySummary"
        },
        "saved_to_burp": {
          "type": "boolean"
        },
        "sent_via_burp": {
          "type": "boolean"
        },
        "staged_to_repeater": {
          "type": "boolean"
        },
        "saved_to_organizer": {
          "type": "boolean"
        },
        "saved_record_uuid": {
          "type": "string"
        },
        "status_code": {
          "type": "integer"
        },
        "response_content_length": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "target",
        "result"
      ]
    },
    "contract.ErrorBody": {
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_id",
            "body_decode_failed",
            "body_incomplete",
            "body_unavailable",
            "budget_exhausted",
            "config_invalid",
            "conflict",
            "database_locked",
            "database_unavailable",
            "export_failed",
            "extension_load_failed",
            "failed",
            "finding_not_found",
            "forbidden",
            "gate_tripped",
            "ingest_incomplete",
            "input_unparsed",
            "internal_error",
            "interrupted",
            "invalid_project_uuid",
            "invalid_request",
            "lint_failed",
            "login_failed",
            "method_not_allowed",
            "no_targets_in_scope",
            "no_targets_reachable",
            "not_authenticated",
            "not_found",
            "not_ready",
            "out_of_scope",
            "output_too_large",
            "partial",
            "payload_too_large",
            "pdf_failed",
            "preflight_failed",
            "project_not_found",
            "provider_missing",
            "provider_unreachable",
            "proxy_auth_required",
            "queue_full",
            "rate_limited",
            "record_not_found",
            "scan_abandoned",
            "scan_not_found",
            "schema_outdated",
            "schema_too_new",
            "service_unavailable",
            "source_incompatible",
            "source_missing",
            "source_unreadable",
            "storage_disabled",
            "timed_out",
            "unauthorized",
            "unsupported_api_version",
            "unsupported_input_mode",
            "usage_error",
            "wait_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "did_you_mean": {
          "type": "string"
        },
        "usage_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        },
        "full_result": {
          "type": "string"
        },
        "dropped_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted"
      ]
    },
    "contract.ReceiptArtifact": {
      "properties": {
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "path",
        "bytes"
      ]
    },
    "http.Header": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "replay.Diff": {
      "properties": {
        "status_changed": {
          "type": "boolean"
        },
        "length_delta": {
          "type": "integer"
        },
        "content_changed": {
          "type": "boolean"
        },
        "reflects_payload": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "baseline_status": {
          "type": "integer"
        },
        "baseline_length": {
          "type": "integer"
        },
        "baseline_content_hash": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status_changed",
        "length_delta",
        "content_changed",
        "baseline_status",
        "baseline_length"
      ]
    },
    "replay.Result": {
      "properties": {
        "mutated_request": {
          "type": "string"
        },
        "mutated_request_truncated": {
          "type": "boolean"
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/replay.Summary"
            },
            {
              "type": "null"
            }
          ]
        },
        "replay": {
          "anyOf": [
            {
              "$ref": "#/$defs/replay.Summary"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/replay.Diff"
            },
            {
              "type": "null"
            }
          ]
        },
        "additional_payload_groups": {
          "type": "integer"
        },
        "unmatched_mutations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "mutated_request",
        "baseline",
        "replay",
        "diff"
      ]
    },
    "replay.Summary": {
      "properties": {
        "status": {
          "type": "integer"
        },
        "response_length": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string"
        },
        "response_time_ms": {
          "type": "integer"
        },
        "headers": {
          "$ref": "#/$defs/http.Header"
        },
        "excerpt": {
          "type": "string"
        },
        "excerpt_truncated": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "final_url": {
          "type": "string"
        },
        "redirects": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "response_length",
        "response_time_ms"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "replay"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/cli.replayOutput"
          },
          {
            "$ref": "#/$defs/cli.replayOnceView"
          },
          {
            "$ref": "#/$defs/cli.replayDryRunView"
          }
        ],
        "description": "The default row, or the row shape selected by: --once --dry-run"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "redacted": {
      "type": "boolean"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    },
    "failed": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium replay -j",
  "description": "One row per replayed record: the baseline, the replay and their diff, and saved_record_uuid when the exchange was stored. A single source is one item; a bulk run counts failed rows. --once prints one compact item instead."
}
