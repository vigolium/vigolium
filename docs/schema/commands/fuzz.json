{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.fuzzPace": {
      "properties": {
        "rate_limit": {
          "type": "number"
        },
        "concurrency": {
          "type": "integer"
        },
        "delay_ms": {
          "type": "integer"
        },
        "protocol": {
          "type": "string"
        },
        "protocol_note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rate_limit",
        "concurrency",
        "delay_ms"
      ]
    },
    "cli.scanNextStep": {
      "properties": {
        "argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "type": "string"
        },
        "sends_traffic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "argv",
        "why"
      ]
    },
    "contract.ErrorBody": {
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_id",
            "body_decode_failed",
            "body_incomplete",
            "body_unavailable",
            "browser_encryption_unsupported",
            "budget_exhausted",
            "config_invalid",
            "conflict",
            "database_locked",
            "database_unavailable",
            "export_failed",
            "extension_load_failed",
            "failed",
            "finding_not_found",
            "forbidden",
            "gate_tripped",
            "ingest_incomplete",
            "input_unparsed",
            "internal_error",
            "interrupted",
            "invalid_project_uuid",
            "invalid_request",
            "keyring_denied",
            "lint_failed",
            "login_failed",
            "method_not_allowed",
            "no_targets_in_scope",
            "no_targets_reachable",
            "not_authenticated",
            "not_found",
            "not_ready",
            "out_of_scope",
            "output_too_large",
            "pace_unsupported",
            "partial",
            "payload_too_large",
            "pdf_failed",
            "preflight_failed",
            "project_not_found",
            "provider_missing",
            "provider_unreachable",
            "proxy_auth_required",
            "queue_full",
            "rate_limited",
            "record_not_found",
            "refused_by_policy",
            "resume_mismatch",
            "scan_abandoned",
            "scan_not_found",
            "scan_running",
            "schema_outdated",
            "schema_too_new",
            "service_unavailable",
            "source_incompatible",
            "source_missing",
            "source_unreadable",
            "storage_disabled",
            "timed_out",
            "unauthorized",
            "unsupported_api_version",
            "unsupported_input_mode",
            "usage_error",
            "wait_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "did_you_mean": {
          "type": "string"
        },
        "usage_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        },
        "full_result": {
          "type": "string"
        },
        "dropped_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted"
      ]
    },
    "contract.ReceiptArtifact": {
      "properties": {
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "path",
        "bytes"
      ]
    },
    "fuzz.AnomalyReason": {
      "properties": {
        "signal": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "weight": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "signal",
        "weight"
      ]
    },
    "fuzz.Baseline": {
      "properties": {
        "status": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "words": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "time_ms": {
          "type": "integer"
        },
        "time_stddev_ms": {
          "type": "number"
        },
        "samples": {
          "type": "integer"
        },
        "time_samples": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "length",
        "words",
        "lines",
        "time_ms"
      ]
    },
    "fuzz.Result": {
      "properties": {
        "position": {
          "type": "string"
        },
        "position_type": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "words": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        },
        "time_ms": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string"
        },
        "reflected": {
          "type": "boolean"
        },
        "reflected_raw": {
          "type": "boolean"
        },
        "reflected_in": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status_changed": {
          "type": "boolean"
        },
        "length_delta": {
          "type": "integer"
        },
        "time_z": {
          "type": "number"
        },
        "anomaly_score": {
          "type": "integer"
        },
        "anomaly_reasons": {
          "items": {
            "$ref": "#/$defs/fuzz.AnomalyReason"
          },
          "type": "array"
        },
        "matched": {
          "type": "boolean"
        },
        "calibrated": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "position",
        "position_type",
        "payload",
        "status",
        "length",
        "words",
        "lines",
        "time_ms",
        "reflected",
        "status_changed",
        "length_delta",
        "matched"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "fuzz"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "description": "true exactly when the command exited 0, 3 or 4; false documents carry error"
    },
    "error": {
      "$ref": "#/$defs/contract.ErrorBody"
    },
    "soft_fail": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/fuzz.Result"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "redacted": {
      "type": "boolean"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "sends_traffic": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "hint": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/contract.ReceiptArtifact"
      },
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "positions": {
      "type": "integer"
    },
    "payloads": {
      "type": "integer"
    },
    "sent": {
      "type": "integer"
    },
    "sent_total": {
      "type": "integer"
    },
    "matched": {
      "type": "integer"
    },
    "calibrated": {
      "type": "integer"
    },
    "errors": {
      "type": "integer"
    },
    "baseline": {
      "$ref": "#/$defs/fuzz.Baseline"
    },
    "anomalies": {
      "items": {
        "$ref": "#/$defs/fuzz.Result"
      },
      "type": "array"
    },
    "anomalies_elided": {
      "type": "integer"
    },
    "sent_via_burp": {
      "type": "boolean"
    },
    "organizer_pushed": {
      "type": "integer"
    },
    "saved_record_uuids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pace": {
      "$ref": "#/$defs/cli.fuzzPace"
    },
    "next": {
      "items": {
        "$ref": "#/$defs/cli.scanNextStep"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "target",
    "positions",
    "payloads",
    "sent",
    "sent_total",
    "matched",
    "calibrated",
    "errors",
    "baseline",
    "pace",
    "kind"
  ],
  "title": "vigolium fuzz -j",
  "description": "The run summary: items are the top-ranked matched results (total is every match); --fields projects them."
}
