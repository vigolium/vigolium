{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/spitolas.UnlockProfile",
  "$defs": {
    "spitolas.UnlockCookie": {
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "value"
      ]
    },
    "spitolas.UnlockProfile": {
      "properties": {
        "origin": {
          "type": "string"
        },
        "localStorage": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "sessionStorage": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "cookies": {
          "items": {
            "$ref": "#/$defs/spitolas.UnlockCookie"
          },
          "type": "array"
        },
        "stubs": {
          "items": {
            "$ref": "#/$defs/spitolas.UnlockStub"
          },
          "type": "array"
        },
        "rewrites": {
          "items": {
            "$ref": "#/$defs/spitolas.UnlockRewrite"
          },
          "type": "array"
        },
        "routes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxRoutes": {
          "type": "integer"
        },
        "settleMs": {
          "type": "integer"
        },
        "maxClicksPerRoute": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "origin"
      ]
    },
    "spitolas.UnlockRewrite": {
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "set": {
          "items": {
            "$ref": "#/$defs/spitolas.UnlockRewriteSet"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "path"
      ]
    },
    "spitolas.UnlockRewriteSet": {
      "properties": {
        "pointer": {
          "type": "string"
        },
        "value": true
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pointer",
        "value"
      ]
    },
    "spitolas.UnlockStub": {
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "contentType": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "path",
        "status"
      ]
    }
  },
  "title": "vigolium unlock-profile",
  "description": "The kit unlock-walk --profile input: origin, localStorage/sessionStorage seeds, cookies, response stubs (same-origin, 2xx/4xx/5xx, body up to 64 KiB), rewrites of real same-origin answers (status 2xx/4xx/5xx and/or up to 20 RFC 6901 pointer sets, values up to 64 KiB; never stored as evidence), routes (maxRoutes default 40, at most 200; settleMs default 2500, at most 10000) and maxClicksPerRoute (default 6, at most 30, 0 off)."
}
