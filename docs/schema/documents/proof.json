{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/output.ProofRecipe",
  "$defs": {
    "output.ProofControl": {
      "oneOf": [
        {
          "required": [
            "method",
            "url",
            "insertion_point",
            "payload_template"
          ]
        },
        {
          "required": [
            "baseline_record_uuid"
          ]
        }
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "body": {
          "type": "string"
        },
        "insertion_point": {
          "$ref": "#/$defs/output.ProofInsertionPoint"
        },
        "payload_template": {
          "type": "string"
        },
        "baseline_record_uuid": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "output.ProofInsertionPoint": {
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "output.ProofOracle": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "body_contains"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "body_absent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "header_contains"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "header",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timing_delta"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "min_delta_ms",
              "repeat"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "body_similarity"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "threshold"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "body_contains",
            "body_absent",
            "status_differs",
            "header_contains",
            "timing_delta",
            "oast_interaction",
            "body_similarity"
          ]
        },
        "value": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "min_delta_ms": {
          "type": "integer"
        },
        "repeat": {
          "type": "integer"
        },
        "threshold": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "output.ProofPreconditions": {
      "properties": {
        "method_safe": {
          "type": "boolean"
        },
        "principal": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method_safe"
      ]
    },
    "output.ProofRecipe": {
      "properties": {
        "request": {
          "$ref": "#/$defs/output.ProofRequest"
        },
        "control": {
          "$ref": "#/$defs/output.ProofControl"
        },
        "oracle": {
          "$ref": "#/$defs/output.ProofOracle"
        },
        "preconditions": {
          "$ref": "#/$defs/output.ProofPreconditions"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "request",
        "control",
        "oracle",
        "preconditions"
      ]
    },
    "output.ProofRequest": {
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "type": "string"
        },
        "insertion_point": {
          "$ref": "#/$defs/output.ProofInsertionPoint"
        },
        "payload_template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "url",
        "headers",
        "insertion_point",
        "payload_template"
      ]
    }
  },
  "title": "vigolium proof",
  "description": "A finding's proof recipe (finding -j proof): the attack request, a control differing only in the value at the insertion point (or baseline_record_uuid), a closed-set oracle over the two responses, and preconditions. {{marker}} in payload_template, url, headers, body and oracle value is where the caller substitutes its own minted marker. Oracles: body_contains (attack body has value, control's does not), body_absent (the reverse), status_differs, header_contains (header has value on the attack only), timing_delta (attack slower by min_delta_ms in each of repeat rounds), oast_interaction (the caller's collector sees the attack's callback), body_similarity (bodies less similar than threshold). Headers never carry credentials, Host or Content-Length."
}
